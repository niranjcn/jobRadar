# jobRadar environment variables. Copy this file to .env and fill in real values.
# SUPABASE_KEY must be the service_role key — it bypasses RLS and is required for
# the app to write. Never expose it in any frontend/browser code.
# DATABASE_URL is the Postgres connection string used to run migrations
# AUTOMATICALLY on startup. Copy the "Connection string → URI" (the pooler one,
# host like aws-0-REGION.pooler.supabase.com) from Supabase Dashboard →
# Project Settings → Database, and replace [YOUR-PASSWORD] with your database
# password. Use your database password, NOT the service role key.
# IMPORTANT: if your database password contains special characters (@ : / # ? etc.)
# they must be URL-encoded in this string (e.g. @ → %40), or the connection will fail.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres.YOURPROJECTREF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: how often the in-app poll loop runs (seconds). Defaults to hourly (3600).
POLL_INTERVAL_SECONDS=3600

# Optional: per-ATS interval overrides, e.g. POLL_INTERVAL_WORKDAY_SECONDS=21600
# (heavy boards poll less often). Also used by GET /api/schedule.
# POLL_INTERVAL_WORKDAY_SECONDS=3600

# Optional: how many boards of one ATS are fetched concurrently.
# Defaults: greenhouse/lever/ashby/remotive/weworkremotely 16, workday/oracle/
# successfactors/avature 10, everything else 8. Rate limits are per-host (each
# company is a different tenant) and the client backs off on 429, so raising
# these is safe up to ~16. Unknown values fall back to the default.
# POLL_CONCURRENCY_WORKDAY=10
# POLL_CONCURRENCY_SUCCESSFACTORS=10

# Optional: delete stored jobs older than this many days (by first_seen_at) on
# each poll. Cascades to job_matches and notifications_sent. Defaults to 30.
JOB_RETENTION_DAYS=30

# Optional: ignore postings whose posted_at date is older than this many days.
# Applies to GH/Lever/Ashby (sources with parseable dates). Sources without a
# date (Workday/Oracle) are stored regardless and rely on JOB_RETENTION_DAYS.
# 0 disables the window. Defaults to 90.
MAX_POSTING_AGE_DAYS=90

# Optional: job-matching preferences. Comma-separated lists. A job matches when its
# title/description/location matches any listed value per category (all empty = match
# everything). "remote" as a location also matches jobs whose location contains
# "remote". Excluded companies never match.
# PREF_ROLES=backend,full stack
# PREF_KEYWORDS=python,postgres
# PREF_LOCATIONS=remote,new york
# PREF_SENIORITY=senior,lead
# PREF_EXCLUDED_COMPANIES=stripe
# PREF_EXCLUDED_ROLES=staff,principal,lead

# Optional: email notifications via Resend test mode (https://resend.com).
# Test mode sends FROM onboarding@resend.dev (hardcoded) and will only deliver
# to the email address you used to sign up for Resend. NOTIFY_ENABLED must be
# true to send. To later send to other recipients / your own domain, verify a
# domain in Resend and change TEST_MODE_FROM in app/notify.py.
# NOTIFY_ENABLED=false
# RESEND_API_KEY=re_xxxxxxxx
# NOTIFY_TO=you@example.com

# Optional: Telegram notifications via BotFather (free, no domain needed).
# Create a bot with @BotFather (/newbot) and copy the token. Message your bot
# once, then get your numeric chat id from @userinfobot. When enabled, EVERY
# new posting is sent (not just preference matches) — to restrict to matches,
# pass only_matched=True in app/poller.py.
#
# The bot also listens for commands (/start, /help, /stats, /jobs, /matches,
# /sources, /schedule, /runs, ...) via getUpdates long polling. The command
# menu is registered on startup with setMyCommands. It only replies to the
# chat id below. Set JOBRADAR_DISABLE_BOT=1 to disable the command listener
# (outbound alerts still work).
#
# Inline mode: type @<botname> <query> in any chat to get a live type-ahead
# list of matching jobs. Enable it once with @BotFather -> /setinline. Inline
# queries only return results to the chat id below (everyone else gets nothing).
#
# Telegram Mini App: a public HTTPS URL of the dashboard. /app sends a WebApp
# button that opens the dashboard inside Telegram. Must be HTTPS and reachable
# by Telegram (e.g. deployed frontend or a tunnel). The dashboard auto-detects
# Telegram and adapts its theme/viewport when opened there.
# TELEGRAM_MINI_APP_URL=https://dashboard.example.com
# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=123456789:AAH...xyz
# TELEGRAM_CHAT_ID=123456789
# ADMIN_CHAT_ID=123456789
# JOBRADAR_DISABLE_BOT=false

# Telegram Login: bot username without @ (needed for t.me deep-link login).
# Find it from @BotFather -> /mybots -> your bot. Used for the web "Open in
# Telegram" button that does `https://t.me/<username>?start=login_<nonce>`.
# TELEGRAM_BOT_USERNAME=YourBotName

# Telegram Login Widget (web "Log in with Telegram" like Google): after
# creating the bot, run @BotFather -> /setdomain -> paste your frontend domain
# (e.g. dashboard.example.com or localhost for local dev via polling). Without
# this the widget popup will be rejected by Telegram.

# ---- Multi-user / subscription access (docs/subscription-plan.md) ----

# Secret used to sign session cookies. REQUIRED once JOBRADAR_REQUIRE_AUTH=true.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=change-me-to-a-long-random-string

# false (default): anonymous API requests act as the owner account — the
# original single-user behavior, unchanged. true: every request must present a
# valid session cookie; locked accounts may only reach auth/unlock endpoints.
# JOBRADAR_REQUIRE_AUTH=false

# Session lifetime in hours. Defaults to 168 (7 days).
# SESSION_TTL_HOURS=168

# Set true when the API is served over HTTPS (production) so session cookies
# carry the Secure attribute. Leave false for local http development.
# SESSION_COOKIE_SECURE=false

# How often the notification-queue drain worker runs (seconds). Due alerts are
# delivered on this cadence; per-user delays are honored via scheduled_for.
# NOTIFY_DRAIN_SECONDS=30

# Payment provider: manual (default; admin unlocks accounts by hand),
# stripe | paddle | lemonsqueezy | razorpay once wired.
# BILLING_PROVIDER=manual

# Extra browser origins allowed to call the API with session cookies
# (comma-separated, e.g. your deployed frontend URL). localhost:3000 is always allowed.
# CORS_ORIGINS=https://dashboard.example.com
