# jobRadar environment variables. Copy this file to .env and fill in real values.
# SUPABASE_KEY must be the service_role key — it bypasses RLS and is required for
# the app to write. Never expose it in any frontend/browser code.
# DATABASE_URL is the Postgres connection string used to run migrations
# AUTOMATICALLY on startup. Copy the "Connection string → URI" (the pooler one,
# host like aws-0-REGION.pooler.supabase.com) from Supabase Dashboard →
# Project Settings → Database, and replace [YOUR-PASSWORD] with your database
# password. Use your database password, NOT the service role key.
# IMPORTANT: if your database password contains special characters (@ : / # ? etc.)
# they must be URL-encoded in this string (e.g. @ → %40), or the connection will fail.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres.YOURPROJECTREF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: how often the in-app poll loop runs (seconds). Defaults to hourly (3600).
POLL_INTERVAL_SECONDS=3600

# Optional: delete stored jobs older than this many days (by first_seen_at) on
# each poll. Cascades to job_matches and notifications_sent. Defaults to 30.
JOB_RETENTION_DAYS=30

# Optional: ignore postings whose posted_at date is older than this many days.
# Applies to GH/Lever/Ashby (sources with parseable dates). Sources without a
# date (Workday/Oracle) are stored regardless and rely on JOB_RETENTION_DAYS.
# 0 disables the window. Defaults to 90.
MAX_POSTING_AGE_DAYS=90

# Optional: job-matching preferences. Comma-separated lists. A job matches when its
# title/description/location matches any listed value per category (all empty = match
# everything). "remote" as a location also matches jobs whose location contains
# "remote". Excluded companies never match.
# PREF_ROLES=backend,full stack
# PREF_KEYWORDS=python,postgres
# PREF_LOCATIONS=remote,new york
# PREF_SENIORITY=senior,lead
# PREF_EXCLUDED_COMPANIES=stripe
# PREF_EXCLUDED_ROLES=staff,principal,lead

# Optional: email notifications via Resend test mode (https://resend.com).
# Test mode sends FROM onboarding@resend.dev (hardcoded) and will only deliver
# to the email address you used to sign up for Resend. NOTIFY_ENABLED must be
# true to send. To later send to other recipients / your own domain, verify a
# domain in Resend and change TEST_MODE_FROM in app/notify.py.
# NOTIFY_ENABLED=false
# RESEND_API_KEY=re_xxxxxxxx
# NOTIFY_TO=you@example.com

# Optional: Telegram notifications via BotFather (free, no domain needed).
# Create a bot with @BotFather (/newbot) and copy the token. Message your bot
# once, then get your numeric chat id from @userinfobot. When enabled, EVERY
# new posting is sent (not just preference matches) — to restrict to matches,
# pass only_matched=True in app/poller.py.
# The bot also answers /start with a welcome message (inbound getUpdates
# long-polling loop; a webhook on the bot would stop that loop).
# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=123456789:AAH...xyz
# TELEGRAM_CHAT_ID=123456789
